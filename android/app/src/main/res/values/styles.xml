<resources>
    <style name="Theme.StreamArena" parent="@android:style/Theme.Material.Light.NoActionBar">
        <item name="android:fontFamily">sans</item>
        <item name="android:windowBackground">#090E1D</item>
        <item name="android:statusBarColor">#090E1D</item>
        <item name="android:navigationBarColor">#090E1D</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:colorAccent">#1F7BDE</item>
        <item name="android:windowActionModeOverlay">true</item>
    </style>

    <style name="Theme.StreamArena.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">#090E1D</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_streamarena</item>
        <item name="postSplashScreenTheme">@style/Theme.StreamArena</item>
    </style>
</resources>
